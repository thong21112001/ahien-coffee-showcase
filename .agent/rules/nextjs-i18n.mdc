# Next.js i18n Rules

## i18n Structure

```
src/
├── locales/
│   ├── en/
│   │   ├── common.json
│   │   ├── products.json
│   │   └── auth.json
│   ├── vi/
│   │   ├── common.json
│   │   ├── products.json
│   │   └── auth.json
│   └── index.ts
├── modules/
│   └── {module}/
│       └── locales/              # Module-specific translations
│           ├── en.json
│           └── vi.json
└── shared/
    └── i18n/
        ├── config.ts
        └── hooks.ts
```

## i18n Configuration

```typescript
// shared/i18n/config.ts
import { initReactI18next } from 'react-i18next';
import i18n from 'i18next';
import enCommon from '@/locales/en/common.json';
import viCommon from '@/locales/vi/common.json';
import enProducts from '@/modules/products/locales/en.json';
import viProducts from '@/modules/products/locales/vi.json';

i18n
  .use(initReactI18next)
  .init({
    resources: {
      en: {
        common: enCommon,
        products: enProducts,
      },
      vi: {
        common: viCommon,
        products: viProducts,
      },
    },
    lng: 'vi', // Default language
    fallbackLng: 'en',
    interpolation: {
      escapeValue: false,
    },
  });

export default i18n;
```

